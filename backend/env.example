# 应用配置
ENVIRONMENT=development
PORT=8080

# 数据库配置
DATABASE_URL=postgres://aiicg:aiicg123@localhost:5432/aiicg?sslmode=disable
REDIS_URL=redis://localhost:6379

# JWT配置
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# 前端配置
FRONTEND_URL=http://localhost:3000

# 云存储配置
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name

# AI服务配置
FAL_API_KEY=your-fal-api-key
FASTGPT_KEY=your-fastgpt-key
UNSPLASH_KEY=your-unsplash-key
PEXELS_KEY=your-pexels-key
GIPHY_KEY=your-giphy-key

# 邮件配置
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=your-email@gmail.com
EMAIL_SMTP_PASSWORD=your-app-password
EMAIL_FROM=AIICG Team <noreply@aiicg.com> 